    "Subject": {
      "additionalProperties": false,
      "description": "One experimental unit. Technical replicates are not subjects.",
      "properties": {
        "subject_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Subject Id",
          "type": "string"
        },
        "study_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
