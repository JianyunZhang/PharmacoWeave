{
  "$defs": {
    "EvidenceQc": {
      "enum": [
        "accepted",
        "rejected",
        "not_reviewed",
        "not_applicable"
      ],
      "title": "EvidenceQc",
      "type": "string"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "description": "One claim, with its evidence grade kept on the record.",
      "properties": {
        "evidence_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "source_project": {
          "$ref": "#/$defs/ProjectName"
        },
        "source_run_id": {
          "minLength": 1,
          "title": "Source Run Id",
          "type": "string"
        },
        "entity_type": {
          "minLength": 1,
          "title": "Entity Type",
          "type": "string"
        },
        "entity_id": {
          "minLength": 1,
          "title": "Entity Id",
          "type": "string"
        },
        "measurement_type": {
          "minLength": 1,
          "title": "Measurement Type",
          "type": "string"
        },
        "evidence_type": {
          "$ref": "#/$defs/EvidenceType"
        },
        "qc_status": {
          "$ref": "#/$defs/EvidenceQc"
        },
        "claim_type": {
          "minLength": 1,
          "title": "Claim Type",
          "type": "string"
        },
        "schema_name": {
          "default": "pharmacology-evidence",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Artifact Id"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "time_context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Context"
        },
        "applicability": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applicability"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "derived_from": {
          "items": {
            "type": "string"
          },
          "title": "Derived From",
          "type": "array"
        },
        "subject_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Id"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "timebase_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timebase Id"
        },
        "sync_error_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sync Error Ms"
        },
        "numeric_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numeric Value"
        }
      },
      "required": [
        "evidence_id",
        "source_project",
        "source_run_id",
        "entity_type",
        "entity_id",
        "measurement_type",
        "evidence_type",
        "qc_status",
        "claim_type"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "EvidenceType": {
      "enum": [
        "observed",
        "estimated",
        "predicted",
        "literature",
        "hypothesis"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "ProjectName": {
      "enum": [
        "pharmacoweave",
        "omicsweave",
        "theraweave",
        "ephysweave",
        "external"
      ],
      "title": "ProjectName",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A file-level bundle of evidence records.",
  "properties": {
    "records": {
      "items": {
        "$ref": "#/$defs/EvidenceRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "schema_name": {
      "default": "pharmacology-evidence-exchange",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "title": "EvidenceExchange",
  "type": "object"
}
