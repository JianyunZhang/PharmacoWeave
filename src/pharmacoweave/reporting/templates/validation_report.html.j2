<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>PharmacoWeave validation report — {{ study_id }}</title>
  <style>
    :root { color-scheme: light; }
    body { margin: 2rem auto; max-width: 56rem; font: 16px/1.5 "Segoe UI", Helvetica, Arial, sans-serif; color: #1c2834; }
    h1 { font-size: 1.6rem; margin-bottom: 0.2rem; }
    h2 { font-size: 1.15rem; margin-top: 1.8rem; }
    p, li { color: #243140; }
    .banner { background: #e8f3f4; border-left: 4px solid #0f6f78; padding: 0.8rem 1rem; }
    table { border-collapse: collapse; width: 100%; margin-top: 0.6rem; }
    th, td { border-bottom: 1px solid #d5dee5; text-align: left; padding: 0.35rem 0.5rem; vertical-align: top; }
    th { font-size: 0.85rem; color: #486070; }
    code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  </style>
</head>
<body>
  <div class="banner">
    <strong>Research use only.</strong>
    This is a research-use report for run <code>{{ run_id }}</code>.
    {% if nca_rows or fit_rows or emax_rows or ivive_rows or audit_summary_rows or simulation_rows %}
    {% if nca_rows %}NCA was run.{% endif %}
    {% if fit_rows %}{{ fit_banner }}{% endif %}
    {% if emax_rows %}Direct/sigmoid Emax exposure-response fitting was run.{% endif %}
    {% if ivive_rows %}Exploratory well-stirred IVIVE was run (predicted grade).{% endif %}
    {% if audit_summary_rows %}Prior prediction fold-error audit was run.{% endif %}
    {% if simulation_rows %}Exploratory single-dose exposure simulation was run from declared parameters.{% endif %}
    It is not a dosing recommendation.
    {% else %}
    NCA, model fitting, and dosing recommendations were not run.
    {% endif %}
  </div>
  <h1>{{ title }}</h1>
  <p>Study <code>{{ study_id }}</code> · {{ data_class }} · {{ species }}</p>
  <p>{{ description }}</p>
  <h2>Inventory</h2>
  <table>
    <thead><tr><th>Item</th><th>Count</th></tr></thead>
    <tbody>
      {% for key, value in counts.items() %}
      <tr><td>{{ key }}</td><td>{{ value }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
  <h2>Validation</h2>
  <p>{{ summary }}</p>
  {% if issues %}
  <table>
    <thead><tr><th>Severity</th><th>Code</th><th>Record</th><th>Message</th></tr></thead>
    <tbody>
      {% for issue in issues %}
      <tr>
        <td>{{ issue.severity }}</td>
        <td><code>{{ issue.code }}</code></td>
        <td>{{ issue.entity_id or "" }}</td>
        <td>{{ issue.message }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p>No validation errors or warnings.</p>
  {% endif %}
  {% if nca_rows %}
  <h2>NCA</h2>
  <p>Units are mg/L, h, mg·h/L, 1/h, L/h, and L. Extravascular routes report apparent CL/F and Vz/F.</p>
  <table>
    <thead>
      <tr>
        <th>Subject</th><th>Route</th><th>AUC last</th><th>AUC inf</th><th>AUC tau</th><th>Extrap</th>
        <th>Half-life</th><th>Clearance</th><th>Volume</th><th>Cmax</th><th>Cmin</th><th>Tmax</th>
      </tr>
    </thead>
    <tbody>
      {% for row in nca_rows %}
      <tr>
        <td>{{ row.subject_id }}</td>
        <td><code>{{ row.route }}</code></td>
        <td>{{ row.auc_last }}</td>
        <td>{{ row.auc_inf }}</td>
        <td>{{ row.auc_tau }}</td>
        <td>{{ row.auc_inf_extrap_fraction }}</td>
        <td>{{ row.half_life }}</td>
        <td>{{ row.clearance }}</td>
        <td>{{ row.volume }}</td>
        <td>{{ row.cmax }}</td>
        <td>{{ row.cmin }}</td>
        <td>{{ row.tmax }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}
  {% if semilog_svg %}
  <h2>Semi-log concentration vs time</h2>
  {{ semilog_svg | safe }}
  {% endif %}
  {% if fit_rows %}
  <h2>Compartmental PK fit</h2>
  <p>Parameters are blank when the diagnostic status is fail. BLQ concentrations are omitted and are not plotted as zero.</p>
  <table>
    <thead>
      <tr><th>Subject</th><th>Model</th><th>Method</th><th>Status</th><th>Estimated Parameters (95% CI)</th></tr>
    </thead>
    <tbody>
      {% for row in fit_rows %}
      <tr>
        <td>{{ row.subject_id }}</td>
        <td><code>{{ row.model_id }}</code></td>
        <td><code>{{ row.method }}</code></td>
        <td>{{ row.status }}</td>
        <td>{{ row.parameters_summary }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% if goodness_of_fit_svg %}
  <h2>Observed vs predicted</h2>
  {{ goodness_of_fit_svg | safe }}
  {% endif %}
  {% if residual_diagnostics_svg %}
  <h2>Residual vs time</h2>
  {{ residual_diagnostics_svg | safe }}
  {% endif %}
  {% if weighted_residuals_svg %}
  <h2>Weighted residual vs time</h2>
  {{ weighted_residuals_svg | safe }}
  {% endif %}
  {% endif %}
  {% if emax_rows %}
  <h2>Direct / Sigmoid Emax</h2>
  <p>Parameters are omitted when the curve is non-identifiable. Predicted effects retain predicted grade.</p>
  <table>
    <thead>
      <tr><th>Fit</th><th>Method</th><th>Status</th><th>E0</th><th>Emax</th><th>EC50</th><th>Hill</th></tr>
    </thead>
    <tbody>
      {% for row in emax_rows %}
      <tr>
        <td><code>{{ row.fit_id }}</code></td>
        <td><code>{{ row.method }}</code></td>
        <td>{{ row.status }}</td>
        <td>{{ row.e0 }}</td>
        <td>{{ row.emax }}</td>
        <td>{{ row.ec50 }}</td>
        <td>{{ row.hill }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% if concentration_effect_svg %}
  <h2>Concentration vs effect</h2>
  {{ concentration_effect_svg | safe }}
  {% endif %}
  {% endif %}
  {% if ivive_rows %}
  <h2>Exploratory IVIVE (Well-Stirred)</h2>
  <p>Exploratory hepatic clearance predictions under caller-supplied physiology. Predicted grade only; not an observed in vivo clearance.</p>
  <table>
    <thead>
      <tr>
        <th>Prediction ID</th><th>Compound</th><th>Species</th><th>Assay</th><th>CLint</th><th>fu,p</th><th>fu,inc</th><th>B:P</th><th>CLH,plasma (L/h)</th><th>CLH,plasma (L/h/kg)</th><th>ER</th>
      </tr>
    </thead>
    <tbody>
      {% for row in ivive_rows %}
      <tr>
        <td><code>{{ row.prediction_id }}</code></td>
        <td>{{ row.compound_id }}</td>
        <td>{{ row.species }}</td>
        <td>{{ row.assay_kind }}</td>
        <td>{{ row.clint_app }}</td>
        <td>{{ row.fu_plasma }}</td>
        <td>{{ row.fu_inc }}</td>
        <td>{{ row.blood_to_plasma_ratio }}</td>
        <td>{{ row.cl_plasma_l_h }}</td>
        <td>{{ row.cl_plasma_l_h_kg }}</td>
        <td>{{ row.extraction_ratio }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}
  {% if simulation_rows %}
  <h2>Exploratory exposure simulation</h2>
  <p>Predicted single-dose curve from declared parameters. This is not an estimate from the study observations and not a dosing recommendation.</p>
  <table>
    <thead>
      <tr>
        <th>Simulation</th><th>Model</th><th>Cmax</th><th>Tmax (h)</th><th>AUC∞</th><th>Terminal t½ (h)</th><th>Time above threshold</th><th>Evidence</th><th>Dosing recommendation</th>
      </tr>
    </thead>
    <tbody>
      {% for row in simulation_rows %}
      <tr>
        <td><code>{{ row.simulation_id }}</code></td>
        <td><code>{{ row.model_id }}</code></td>
        <td>{{ row.cmax }}</td>
        <td>{{ row.tmax_h }}</td>
        <td>{{ row.auc_inf }}</td>
        <td>{{ row.half_life_h }}</td>
        <td>{{ row.time_above }}</td>
        <td>{{ row.evidence_type }}</td>
        <td>{{ row.dosing_recommendation }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}
  {% if audit_summary_rows %}
  <h2>Prior vs. Posterior Prediction Audit</h2>
  <p>Fold-error calibration between prior predictions (predicted) and in vivo estimates (estimated).</p>
  <table>
    <thead>
      <tr>
        <th>Measurement</th><th>N</th><th>AFE</th><th>AAFE</th><th>Within 2-fold</th><th>Within 3-fold</th><th>Outliers (&gt;2-fold)</th>
      </tr>
    </thead>
    <tbody>
      {% for row in audit_summary_rows %}
      <tr>
        <td><code>{{ row.measurement_type }}</code></td>
        <td>{{ row.n_comparisons }}</td>
        <td>{{ row.afe }}</td>
        <td>{{ row.aafe }}</td>
        <td>{{ row.fraction_within_2_fold }}</td>
        <td>{{ row.fraction_within_3_fold }}</td>
        <td>{{ row.n_outlier_2_fold }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% if audit_entry_rows %}
  <h3>Comparison Details</h3>
  <table>
    <thead>
      <tr>
        <th>Prior ID</th><th>Estimate ID</th><th>Measurement</th><th>Predicted</th><th>Estimated</th><th>Ratio (P/O)</th><th>Fold Error</th><th>Bias</th>
      </tr>
    </thead>
    <tbody>
      {% for row in audit_entry_rows %}
      <tr>
        <td><code>{{ row.prior_id }}</code></td>
        <td><code>{{ row.estimate_id }}</code></td>
        <td>{{ row.measurement_type }}</td>
        <td>{{ row.predicted }}</td>
        <td>{{ row.estimated }}</td>
        <td>{{ row.ratio }}</td>
        <td>{{ row.fold_error }}</td>
        <td>{{ row.bias }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}
  {% if audit_skipped_rows %}
  <h3>Skipped Prior Audits</h3>
  <table>
    <thead>
      <tr>
        <th>Prior ID</th><th>Reason</th>
      </tr>
    </thead>
    <tbody>
      {% for row in audit_skipped_rows %}
      <tr>
        <td><code>{{ row.prior_id }}</code></td>
        <td>{{ row.reason }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}
  {% endif %}
  <h2>Not in this bundle</h2>
  <ul>
    {% for item in omitted %}
    <li><code>{{ item.role }}</code>: {{ item.reason }}</li>
    {% endfor %}
  </ul>
  <h2>Software</h2>
  <p>PharmacoWeave {{ version }}, schema {{ schema_version }}, written {{ generated_at }}.</p>
</body>
</html>
